{
  "name": "web-amble",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "web-amble — a storefront for the whole web. Discover, browse and submit websites.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "inspect": "tsx scripts/inspect.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:repair": "tsx scripts/repair.ts",
    "db:dedupe": "tsx scripts/dedupe.ts",
    "reclassify": "tsx scripts/reclassify.ts",
    "worker": "tsx workers/worker.ts",
    "ingest": "tsx scripts/ingest.ts",
    "discover": "tsx scripts/discover.ts",
    "rescore": "tsx scripts/rescore.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke.ts",
    "score": "tsx scripts/score.ts",
    "audit": "tsx scripts/audit.ts",
    "triage": "tsx scripts/triage.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.10",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^16.2.12",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
