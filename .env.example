# --- web-amble configuration -----------------------------------------------
# Copy to .env.local for development. DATABASE_URL and WORKER_TOKEN are the only
# two a deploy really needs; everything else has a working default.

# Public URL. On Netlify this is detected automatically from $URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=web-amble

# --- database ---------------------------------------------------------------
# Postgres connection string. Use a POOLED connection — serverless invocations
# open and drop connections constantly and would exhaust a direct pool.
#
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler"
#   postgresql://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Then populate it once from your machine:
#   DATABASE_URL=... npm run setup
#
DATABASE_URL=
DB_POOL_SIZE=3

# Local scratch directory for generated cover art in development.
# On Netlify, cover art is stored in Netlify Blobs automatically.
WEBAMBLE_DATA_DIR=./data

# --- background worker ------------------------------------------------------
# Shared secret for /api/worker. REQUIRED in production: without it the
# scheduled function refuses to run and the catalogue stops updating.
# Generate one with:  node -e "console.log(crypto.randomUUID())"
WORKER_TOKEN=

WORKER_ENABLED=1
WORKER_TICK_MS=4000
# Auto-approve discovered sites above this quality score (0..1). 0 disables.
AUTO_APPROVE_QUALITY=0.72

# --- seed administrator -----------------------------------------------------
# Created by `npm run db:seed`. Change these before deploying anywhere public.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying
ADMIN_EMAIL=admin@localhost

# --- crawler ----------------------------------------------------------------
CRAWLER_USER_AGENT=AmbleBot/1.0 (+http://localhost:3000/about#bot)
CRAWLER_TIMEOUT_MS=12000
CRAWLER_MAX_HTML_BYTES=1500000
CRAWLER_CONCURRENCY=4
CRAWLER_HOST_DELAY_MS=1500
CRAWLER_RESPECT_ROBOTS=1

# Optional: real screenshots instead of og:image.
# Requires `npm i -D playwright && npx playwright install chromium`.
# Not available on Netlify Functions.
SCREENSHOTS_ENABLED=0

# Log every SQL statement with timing and queue depth. Invaluable when a page
# hangs — it shows exactly which query never came back.
DB_TRACE=0
