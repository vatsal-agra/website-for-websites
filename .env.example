# --- Portico configuration -------------------------------------------------
# Copy to .env.local for development. Everything has a working default locally;
# the DATABASE and WORKER_TOKEN entries are the only ones a deploy really needs.

# Public URL. On Netlify this is detected automatically from $URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Portico

# --- database ---------------------------------------------------------------
# Leave TURSO_DATABASE_URL empty for local development and Portico uses a
# SQLite file in PORTICO_DATA_DIR. Serverless hosts have no persistent disk, so
# a deploy needs a hosted libSQL database:
#
#   1. turso db create portico          (or use the Turso web dashboard)
#   2. turso db show portico --url      -> TURSO_DATABASE_URL
#   3. turso db tokens create portico   -> TURSO_AUTH_TOKEN
#   4. npm run db:migrate && npm run db:seed   with both set, to populate it
#
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Where the local SQLite file and generated thumbnails live (dev only —
# on Netlify, cover art is stored in Netlify Blobs automatically).
PORTICO_DATA_DIR=./data

# --- background worker ------------------------------------------------------
# Shared secret for /api/worker. REQUIRED in production: without it the
# scheduled function refuses to run and the catalogue stops updating.
# Generate one with:  node -e "console.log(crypto.randomUUID())"
WORKER_TOKEN=

WORKER_ENABLED=1
WORKER_TICK_MS=4000
# Auto-approve discovered sites above this quality score (0..1). 0 disables.
AUTO_APPROVE_QUALITY=0.72

# --- seed administrator -----------------------------------------------------
# Created by `npm run db:seed`. Change these before deploying anywhere public.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=portico-admin
ADMIN_EMAIL=admin@localhost

# --- crawler ----------------------------------------------------------------
CRAWLER_USER_AGENT=PorticoBot/1.0 (+http://localhost:3000/about#bot)
CRAWLER_TIMEOUT_MS=12000
CRAWLER_MAX_HTML_BYTES=1500000
CRAWLER_CONCURRENCY=4
CRAWLER_HOST_DELAY_MS=1500
CRAWLER_RESPECT_ROBOTS=1

# Optional: real screenshots instead of og:image.
# Requires `npm i -D playwright && npx playwright install chromium`.
# Not available on Netlify Functions.
SCREENSHOTS_ENABLED=0
